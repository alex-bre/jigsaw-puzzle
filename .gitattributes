# LF everywhere, regardless of core.autocrlf on the machine.
* text=auto eol=lf

# Windows batch files must keep CRLF (cmd.exe misparses labels/goto with LF).
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.jar binary
*.jks binary
*.keystore binary
*.ttf binary
*.woff binary
*.woff2 binary
